# Environment
NODE_ENV=development

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only read token (Viewer role). Reads collection access codes, which
# live in authenticated-only companion documents. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Shared with the Sanity webhook that calls /api/revalidate (see README).
SANITY_REVALIDATE_SECRET=

# Licenses
NEXT_PUBLIC_LG_LICENSE_KEY=

# Security
# Also the root secret for private-collection access tokens and prepared
# download tokens (per-purpose keys are derived from it via HKDF).
ENCRYPTION_KEY=

# Private collections
# Migration window only: when a collection has no companion document yet, also
# check the code still stored on its public collection document. Leave false
# (the default) once every code has been copied; then remove it.
COLLECTION_ACCESS_LEGACY_PUBLIC_FALLBACK=false

# Collection access attempts (POST /api/verifyAccess)
# All attempts per address; failed attempts per address and collection; failed
# attempts per collection from all addresses (a high ceiling).
ACCESS_RATE_LIMIT_IP=20
ACCESS_RATE_LIMIT_IP_WINDOW=900000
ACCESS_RATE_LIMIT_COLLECTION=10
ACCESS_RATE_LIMIT_COLLECTION_WINDOW=900000
ACCESS_RATE_LIMIT_COLLECTION_GLOBAL=100
ACCESS_RATE_LIMIT_COLLECTION_GLOBAL_WINDOW=900000

# Redis
REDIS_ENABLED=true
REDIS_URL=

# Download Rate Limiting (legacy full/part downloads)
DOWNLOAD_ALL_RATE_LIMIT=100
DOWNLOAD_PART_RATE_LIMIT_PER_COLLECTION=100
DOWNLOAD_LEGACY_RATE_LIMIT_WINDOW=14400000

# Download Stream Rate Limiting
DOWNLOAD_STREAM_RATE_LIMIT=6
DOWNLOAD_STREAM_RATE_LIMIT_WINDOW=3600000

# Contact Rate Limiting
CONTACT_RATE_LIMIT=10
CONTACT_RATE_LIMIT_WINDOW=3600000
CONTACT_IDENTITY_RATE_LIMIT=3
CONTACT_IDENTITY_RATE_LIMIT_WINDOW=86400000
n# Mailing-list opt-in (download drawer) Rate Limiting
AUDIENCE_RATE_LIMIT=5
AUDIENCE_RATE_LIMIT_WINDOW=3600000

# Email
EMAIL=contact@mogz.studio
# Use a verified sender on your Resend domain, e.g. website@mogz.studio
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking Session
NEXT_PUBLIC_BOOKING_SESSION_KEY=mogz_booking_draft

# Booking Rate Limiting
BOOKING_RATE_LIMIT_IP=5
BOOKING_RATE_LIMIT_WINDOW=3600000
BOOKING_IDENTITY_RATE_LIMIT=3
BOOKING_IDENTITY_RATE_LIMIT_WINDOW=43200000
BOOKING_DUPLICATE_RATE_LIMIT=1
BOOKING_DUPLICATE_RATE_LIMIT_WINDOW=300000
